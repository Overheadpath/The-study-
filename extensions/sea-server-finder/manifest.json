{
  "manifest_version": 3,
  "name": "Sea Server Finder",
  "version": "1.0.0",
  "description": "Find low-ping Roblox servers in any place of a game, including Blox Fruits' Second and Third Sea.",
  "permissions": ["storage"],
  "host_permissions": ["https://ipwho.is/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Sea Server Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
