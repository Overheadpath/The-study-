{
  "name": "blackjack-strategy-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Educational blackjack basic-strategy trainer: hand analysis, probability explanations, and a practice simulator with virtual chips. Not for real-money gambling.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build-single.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:browser": "node --test \"tests/browser/*.test.js\"",
    "build:charts": "node scripts/build-charts.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
